{% extends 'base.html.twig' %}
{% block title %}LoginController{% endblock %}

{% block body %}
    {% include 'menu/menu.html.twig' %}

    <div class="container-fluid px-3">
        <h1 class="display-5">Connexion</h1>
        <div class="row">
            <div class="col" style="max-width: 32em">
                {% if error %}
                    <div class="alert alert-danger mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                <div class="card">
                    <div class="card-body">
                        <form action="{{ path('app_login') }}" method="post" class="row justify-content-around">
                            <!-- Email input -->
                            <div class="mb-3 col-12">
                                <label class="form-label" for="username">Email address</label>
                                <input type="text" id="username" name="_username" class="form-control" value="{{ last_username }}">
                            </div>

                            <!-- Password input -->
                            <div class="mb-3 col-12">
                                <label class="form-label" for="password">Password</label>
                                <input type="password" id="password" class="form-control" name="_password">
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <!-- Submit button -->
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100 my-1">Login</button>
                                <a href="#reset" class="btn btn-secondary w-100 my-1">Reset</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
